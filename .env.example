# ─── 앱 ──────────────────────────────────────────────────────────────────────
SALGIL_ENV=local                     # local | staging | production
SALGIL_LOG_LEVEL=INFO
SALGIL_LOG_JSON=false                # 운영에서는 true

# ─── 데이터베이스 ────────────────────────────────────────────────────────────
# compose 안에서는 host 가 db, 로컬 실행이면 127.0.0.1
SALGIL_DATABASE_URL=postgresql+asyncpg://salgil:salgil@127.0.0.1:5432/salgil

# ─── GB SafeData (읽기 전용 상류) ────────────────────────────────────────────
# 배포된 서비스를 그대로 쓴다. 자체 호스팅 시 이 값만 바꾼다.
SALGIL_GBSAFE_BASE_URL=https://datainfra.salgil.gyeongbuk.kr
SALGIL_GBSAFE_TIMEOUT_S=30.0
SALGIL_GBSAFE_CONTEXT_TIMEOUT_S=120.0   # 여러 원천을 병렬 조회하므로 길다
SALGIL_GBSAFE_CACHE_TTL_S=60            # 상류도 캐시하지만 호출 한도를 한 번 더 보호

# ─── ML Engine (추론 서비스) ─────────────────────────────────────────────────
# jxkr2026-mlengine 은 아직 학습 전용이라 서빙 면이 없다.
# stub 이면 계약만 지킨 합성 응답을 돌려주고 is_stub=true 를 붙인다.
SALGIL_MLENGINE_MODE=stub               # stub | http
SALGIL_MLENGINE_BASE_URL=http://127.0.0.1:8900
SALGIL_MLENGINE_TIMEOUT_S=60.0
SALGIL_MLENGINE_API_KEY=

# ─── 인증 ────────────────────────────────────────────────────────────────────
# 해커톤 단계의 정적 키. 형식: "키:역할,키:역할"
# 역할: operator(조회+기안) | approver(승인) | field(현장보고) | admin
SALGIL_API_KEYS=dev-operator:operator,dev-approver:approver,dev-field:field

# ─── CORS ────────────────────────────────────────────────────────────────────
SALGIL_CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:5173,http://localhost:5174,http://localhost:5175
